{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expiration-tracker/schemas/queues/notification-whatsapp-digest-deliver.v1.json",
  "title": "WhatsAppDigestFlushRequested.data (SQS_NOTIFICATION_WHATSAPP_DIGEST_V1)",
  "description": "SQS command payload consumed by WhatsAppDigestDeliveryWorker (D-347 §3.5). Bare event.data payload - no envelope wrapping (command-envelope.v1.json) - same convention SQS_REPORT_SUBSCRIPTION_DELIVERY_V1 already established for a scheduler-fed, periodic-claim destination (whatsapp-digest-flush.ts's own doc comment).",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "recipientUserId", "windowDate", "items"],
  "properties": {
    "tenantId": { "type": "string", "minLength": 1 },
    "recipientUserId": { "type": "string", "minLength": 1 },
    "windowDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intentId", "attemptId", "itemId", "itemVersion", "addedAt"],
        "properties": {
          "intentId": { "type": "string", "minLength": 1 },
          "attemptId": { "type": "string", "minLength": 1 },
          "itemId": { "type": "string", "minLength": 1 },
          "itemVersion": { "type": "integer", "minimum": 1 },
          "addedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
