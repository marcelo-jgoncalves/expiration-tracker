{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expiration-tracker/schemas/api/update-notification-preferences-request.v1.json",
  "title": "UpdateNotificationPreferencesRequest v1",
  "description": "PUT /notifications/preferences request body (src/modules/notification/domain/notification-preferences.ts NotificationPreferences' user-editable fields).",
  "type": "object",
  "additionalProperties": false,
  "required": ["emailEnabled", "locale"],
  "properties": {
    "emailEnabled": { "type": "boolean" },
    "locale": { "type": "string", "minLength": 2, "maxLength": 20 },
    "quietHours": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["enabled", "startLocal", "endLocal", "timeZone"],
      "properties": {
        "enabled": { "type": "boolean" },
        "startLocal": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "endLocal": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "timeZone": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  }
}
