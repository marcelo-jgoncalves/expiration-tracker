{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expiration-tracker/schemas/api/docarchive-document-metadata-values-update-request.v1.json",
  "title": "DocArchiveDocumentMetadataValuesUpdateRequest v1",
  "description": "PATCH /document-archive/documents/{documentId}/metadata-values request body (D-218 fatia 2, DocumentMetadataValueInput map + OCC guard on the Document). A `null` entry clears that field entirely; a fieldId simply absent from `values` is left untouched (true partial update) - these are two distinct operations, never conflated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["expectedDocumentVersion", "values"],
  "properties": {
    "expectedDocumentVersion": { "type": "integer", "minimum": 1 },
    "values": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "null" },
          { "type": "object", "additionalProperties": false, "required": ["valueType", "value"], "properties": { "valueType": { "const": "TEXT" }, "value": { "type": "string" } } },
          { "type": "object", "additionalProperties": false, "required": ["valueType", "value"], "properties": { "valueType": { "const": "NUMBER" }, "value": { "type": "number" } } },
          { "type": "object", "additionalProperties": false, "required": ["valueType", "value"], "properties": { "valueType": { "const": "DECIMAL" }, "value": { "type": "string" } } },
          { "type": "object", "additionalProperties": false, "required": ["valueType", "value"], "properties": { "valueType": { "const": "DATE" }, "value": { "type": "string" } } },
          { "type": "object", "additionalProperties": false, "required": ["valueType", "value"], "properties": { "valueType": { "const": "BOOLEAN" }, "value": { "type": "boolean" } } },
          { "type": "object", "additionalProperties": false, "required": ["valueType", "optionId"], "properties": { "valueType": { "const": "SINGLE_SELECT" }, "optionId": { "type": "string", "minLength": 1 } } }
        ]
      }
    }
  }
}
