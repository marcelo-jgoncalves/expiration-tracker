{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expiration-tracker/schemas/api/confirm-extracted-field-request.v1.json",
  "title": "ConfirmExtractedFieldRequest v1",
  "description": "POST /items/{itemId}/documents/{documentId}/extractions/{runId}/fields/{fieldName}/confirm request body (m7-extraction-design/claude-reconciliation-final-design.md §1.7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["expectedItemVersion", "expectedDocumentVersion", "expectedRunVersion", "expectedFieldVersion", "confirmedValue"],
  "properties": {
    "expectedItemVersion": { "type": "integer", "minimum": 1 },
    "expectedDocumentVersion": { "type": "integer", "minimum": 1 },
    "expectedRunVersion": { "type": "integer", "minimum": 1 },
    "expectedFieldVersion": { "type": "integer", "minimum": 1 },
    "confirmedValue": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
