        "properties": {
          "role": { "type": "string", "enum": ["PRINCIPAL", "ATTACHMENT"] },
          "mediaType": { "type": "string", "minLength": 1 },
          "contentLength": { "type": "integer", "minimum": 1 },
          "checksumSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
