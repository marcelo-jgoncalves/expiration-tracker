{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expiration-tracker/schemas/api/update-item-request.v1.json",
  "title": "UpdateItemRequest v1",
  "description": "PUT /items/{itemId} request body (src/modules/expiration/domain/expiration-item.ts UpdateItemInput). Never includes status/version/renewedFromId - those are controlled by dedicated operations, so the schema deliberately omits them (additionalProperties:false rejects them if a client sends them).",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "category": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "maxLength": 2000 },
    "dueDate": { "type": "string", "format": "date-time" },
    "issueDate": { "type": "string", "format": "date-time" },
    "periodicity": { "type": "string", "maxLength": 50 },
    "issuer": { "type": "string", "maxLength": 200 },
    "number": { "type": "string", "maxLength": 100 },
    "assigneeUserId": { "type": "string", "maxLength": 100 },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 50 }, "maxItems": 20 },
    "priority": { "type": "string", "maxLength": 50 }
  }
}
