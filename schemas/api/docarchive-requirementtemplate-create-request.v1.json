{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expiration-tracker/schemas/api/docarchive-requirementtemplate-create-request.v1.json",
  "title": "DocArchiveRequirementTemplateCreateRequest v1",
  "description": "POST /document-archive/requirement-templates request body. P0.1. maxItems mirrors MAX_TEMPLATE_ITEMS (30); maxLength counts code points and is the cheap first barrier - the deciding barrier is the UTF-8 BYTE limit enforced in the service.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "displayName",
    "items"
  ],
  "properties": {
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "applicability": {
            "enum": [
              "APPLICABLE",
              "NOT_APPLICABLE"
            ]
          }
        }
      }
    }
  }
}
