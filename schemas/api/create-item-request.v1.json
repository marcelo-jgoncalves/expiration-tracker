{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expiration-tracker/schemas/api/create-item-request.v1.json",
  "title": "CreateItemRequest v1",
  "description": "POST /items request body (src/modules/expiration/domain/expiration-item.ts CreateItemInput). full-audit round1/Seguranca criterio 5: HTTP boundary had no runtime schema validation - client-controlled JSON reached DynamoDB with only compile-time typing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "category", "dueDate"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "category": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "maxLength": 2000 },
    "dueDate": { "type": "string", "format": "date-time" },
    "issueDate": { "type": "string", "format": "date-time" },
    "periodicity": { "type": "string", "maxLength": 50 },
    "issuer": { "type": "string", "maxLength": 200 },
    "number": { "type": "string", "maxLength": 100 },
    "assigneeUserId": { "type": "string", "maxLength": 100 },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 50 }, "maxItems": 20 },
    "priority": { "type": "string", "maxLength": 50 }
  }
}
