{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expiration-tracker/schemas/api/report-subscription-create-request.v1.json",
  "title": "ReportSubscriptionCreateRequest v1",
  "description": "POST /reports/subscriptions request body (D-204 decision 1, Roadmap P1 item 15, implemented D-213). cadence is deliberately NOT a field here - v1 supports only WEEKLY, so it is fixed server-side rather than accepted and validated against a 1-value enum.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reportTypes", "dayOfWeek", "localTime", "timeZone", "recipientUserIds"],
  "properties": {
    "reportTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "string",
        "enum": ["EXPIRED_ITEMS", "EXPIRING_SOON_ITEMS", "RENEWED_ITEMS", "EXPIRATION_ITEMS_BY_ASSIGNEE", "MISSING_REQUIREMENTS", "REQUIREMENTS_BY_SUBJECT", "REQUIREMENTS_BY_ASSIGNEE"]
      }
    },
    "dayOfWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
    "localTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "timeZone": { "type": "string", "minLength": 1, "maxLength": 100 },
    "recipientUserIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    }
  }
}
