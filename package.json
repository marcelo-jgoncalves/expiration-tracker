{
  "name": "expiration-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Micro-SaaS de controle de vencimentos/renovacoes - guardrails e contratos (M0)",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate-schemas": "tsx scripts/validate-schemas.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/coverage-v8": "4.1.11",
    "aws-cdk-lib": "2.265.0",
    "aws-jwt-verify": "5.2.1",
    "constructs": "10.8.1",
    "eslint": "^8.57.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "ajv": "^8.16.0",
    "ajv-formats": "^2.1.1",
    "ulid": "^2.3.0"
  }
}
