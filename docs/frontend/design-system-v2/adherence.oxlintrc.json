{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/shell/**",
              "ui_kits/webapp/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShellNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|current|onClick|key|ref|className|style|children)$/]",
        "message": "<AppShellNavItem> doesn't accept that prop. Declared props: label, href, current, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='AsyncFeedback'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|message|key|ref|className|style|children)$/]",
        "message": "<AsyncFeedback> doesn't accept that prop. Declared props: state, message."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackgroundRefreshIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<BackgroundRefreshIndicator> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|pending|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, pending, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|children|key|ref|className|style|children)$/]",
        "message": "<ButtonLink> doesn't accept that prop. Declared props: variant, size, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CollectionSkeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|label|key|ref|className|style|children)$/]",
        "message": "<CollectionSkeleton> doesn't accept that prop. Declared props: rows, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|header|primary|numeric|actions|render|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, header, primary, numeric, actions, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DetailField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<DetailField> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|message|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: kind, message, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorState'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|onRetry|retryLabel|key|ref|className|style|children)$/]",
        "message": "<ErrorState> doesn't accept that prop. Declared props: message, onRetry, retryLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|count|key|ref|className|style|children)$/]",
        "message": "<FilterOption> doesn't accept that prop. Declared props: value, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='SummaryFieldError'] > JSXAttribute > JSXIdentifier[name!=/^(?:fieldId|label|message|key|ref|className|style|children)$/]",
        "message": "<SummaryFieldError> doesn't accept that prop. Declared props: fieldId, label, message."
      },
      {
        "selector": "JSXOpeningElement[name.name='InitialLoading'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<InitialLoading> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|actions|announce|key|ref|className|style|children)$/]",
        "message": "<InlineNotice> doesn't accept that prop. Declared props: tone, title, children, actions, announce."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineNotice'] > JSXAttribute[name.name='announce'] > Literal[value!=/^(?:alert|status|none)$/]",
        "message": "<InlineNotice> announce must be one of 'alert' | 'status' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|above|badges|actions|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, description, above, badges, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padded|header|footer|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: children, padded, header, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|headingId|annotation|description|children|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: heading, headingId, annotation, description, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|srPrefix|wrap|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: label, tone, srPrefix, wrap."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|error|hint|required|maxLength|type|autoComplete|multiline|id|width|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, onChange, error, hint, required, maxLength, type, autoComplete, multiline, id, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|date)$/]",
        "message": "<TextField> type must be one of 'text' | 'date'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:date|sm|md)$/]",
        "message": "<TextField> width must be one of 'date' | 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toolbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Toolbar> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='UrgencyIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|wrap|key|ref|className|style|children)$/]",
        "message": "<UrgencyIndicator> doesn't accept that prop. Declared props: label, tone, wrap."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
